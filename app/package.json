{
  "name": "flow-atlas",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Explorateur du modèle publié FLOW : React, React Flow et serveur local Python.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
